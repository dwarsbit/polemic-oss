{
  "name": "@scholarkit/i18n",
  "version": "0.1.0",
  "private": true,
  "description": "Interface languages for the Scholarkit apps: the active language, message lookup, plurals and the message catalogs' tooling.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./translator": {
      "types": "./dist/translator.d.ts",
      "default": "./dist/translator.js"
    },
    "./react": "./src/react.tsx",
    "./context": "./src/context.tsx",
    "./extract": {
      "types": "./scripts/extract.d.mts",
      "default": "./scripts/extract.mjs"
    }
  },
  "bin": {
    "scholarkit-i18n": "./scripts/cli.mjs"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint .",
    "typecheck": "tsc",
    "test": "vitest run"
  },
  "peerDependencies": {
    "react": "^19.3.1"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@scholarkit/eslint-config": "workspace:*",
    "@scholarkit/tsconfig": "workspace:*",
    "@types/node": "catalog:",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "catalog:",
    "globals": "catalog:",
    "happy-dom": "catalog:",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}

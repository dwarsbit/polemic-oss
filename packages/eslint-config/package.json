{
  "name": "@scholarkit/eslint-config",
  "version": "0.0.0",
  "private": true,
  "description": "Shared ESLint presets for the Scholarkit workspace.",
  "type": "module",
  "exports": {
    ".": "./src/index.js",
    "./base": "./src/base.js",
    "./i18n": "./src/i18n.js",
    "./next": "./src/next.js",
    "./node": "./src/node.js",
    "./react": "./src/react.js"
  },
  "files": [
    "src"
  ],
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@eslint/js": "catalog:",
    "@next/eslint-plugin-next": "catalog:",
    "eslint-config-prettier": "catalog:",
    "eslint-plugin-react-hooks": "catalog:",
    "globals": "catalog:",
    "typescript-eslint": "catalog:"
  },
  "devDependencies": {
    "@scholarkit/tsconfig": "workspace:*",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "eslint": "^10.0.0",
    "typescript": ">=5.8"
  }
}

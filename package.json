{
  "name": "@scholarkit/polemic",
  "private": true,
  "version": "0.27.0",
  "type": "module",
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "dev:web": "vite --mode web",
    "build": "vite build && vite build --mode web",
    "build:desktop": "vite build",
    "build:web": "vite build --mode web",
    "preview": "vite preview",
    "tauri": "tauri",
    "lint": "eslint .",
    "typecheck": "tsc",
    "test": "vitest run",
    "i18n": "scholarkit-i18n extract src node_modules/@scholarkit/updates/src node_modules/@scholarkit/account-menu/src node_modules/@scholarkit/collab/src src/locales",
    "lint:rust": "cargo fmt --check --manifest-path src-tauri/Cargo.toml && cargo fmt --check --manifest-path tools/corpus/probe/Cargo.toml && cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets --locked -- -D warnings",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml --locked && cargo test --manifest-path tools/corpus/probe/Cargo.toml --locked",
    "prepare": "pnpm --filter @scholarkit/i18n --filter @scholarkit/monitoring build"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/language": "^6.12.4",
    "@codemirror/legacy-modes": "^6.5.4",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.13",
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource-variable/fira-code": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/source-code-pro": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@hocuspocus/provider": "4.7.1",
    "@lezer/highlight": "^1.2.4",
    "@scholarkit/i18n": "workspace:*",
    "@scholarkit/monitoring": "workspace:*",
    "@scholarkit/account-menu": "workspace:*",
    "@scholarkit/collab": "workspace:*",
    "@scholarkit/updates": "workspace:*",
    "@tanstack/react-query": "^5.104.0",
    "@tauri-apps/api": "^2.12.0",
    "@tauri-apps/plugin-dialog": "^2.8.0",
    "@tauri-apps/plugin-opener": "^2.6.0",
    "@tauri-apps/plugin-window-state": "2.5.0",
    "@tiptap/core": "^3.31.4",
    "@tiptap/extension-document": "^3.31.4",
    "@tiptap/extension-hard-break": "^3.31.4",
    "@tiptap/extension-heading": "^3.31.4",
    "@tiptap/extension-list-item": "^3.31.4",
    "@tiptap/pm": "^3.31.4",
    "@tiptap/react": "^3.31.4",
    "@tiptap/starter-kit": "^3.31.4",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "codemirror": "^6.0.2",
    "date-fns": "^4.4.0",
    "fflate": "catalog:",
    "katex": "^0.18.9",
    "lucide-react": "^1.48.0",
    "pdfjs-dist": "^6.3.289",
    "radix-ui": "^1.6.7",
    "react": "^19.1.0",
    "react-day-picker": "^10.0.2",
    "react-dom": "^19.1.0",
    "react-resizable-panels": "^4.13.3",
    "tw-animate-css": "^1.4.0",
    "yjs": "13.6.33",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@scholarkit/eslint-config": "workspace:*",
    "@scholarkit/tsconfig": "workspace:*",
    "@sentry/vite-plugin": "catalog:",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2.12.0",
    "@types/katex": "^0.16.8",
    "@types/node": "catalog:",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^6.0.2",
    "eslint": "catalog:",
    "globals": "catalog:",
    "happy-dom": "catalog:",
    "shadcn": "^4.21.0",
    "tailwindcss": "^4.3.3",
    "typescript": "catalog:",
    "vite": "^8.0.16",
    "vitest": "catalog:"
  }
}
